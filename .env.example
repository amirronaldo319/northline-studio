# Copy to `.env` and fill in. Both values are public (they ship in the browser bundle);
# never put private API keys here.

# Form service endpoint that accepts a JSON POST, e.g. a Formspree form:
# VITE_FORM_ENDPOINT=https://formspree.io/f/your-form-id
VITE_FORM_ENDPOINT=

# Final public URL of the site, no trailing slash. Enables canonical, og:url, and sitemap.xml.
# VITE_SITE_URL=https://www.example.ca
VITE_SITE_URL=
